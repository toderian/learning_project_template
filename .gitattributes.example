* text=auto eol=lf
*.md text eol=lf
*.txt text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.sh text eol=lf

04_areas/**/assets/attachments/**/*.pdf filter=lfs diff=lfs merge=lfs -text
04_areas/**/assets/attachments/**/*.mp3 filter=lfs diff=lfs merge=lfs -text
04_areas/**/assets/attachments/**/*.mp4 filter=lfs diff=lfs merge=lfs -text
04_areas/**/assets/attachments/**/*.wav filter=lfs diff=lfs merge=lfs -text
04_areas/**/assets/attachments/**/*.zip filter=lfs diff=lfs merge=lfs -text
04_areas/**/assets/images/**/*.png filter=lfs diff=lfs merge=lfs -text
04_areas/**/assets/images/**/*.jpg filter=lfs diff=lfs merge=lfs -text
04_areas/**/assets/images/**/*.jpeg filter=lfs diff=lfs merge=lfs -text
04_areas/**/assets/images/**/*.gif filter=lfs diff=lfs merge=lfs -text
04_areas/**/assets/imports/**/*.zip filter=lfs diff=lfs merge=lfs -text
